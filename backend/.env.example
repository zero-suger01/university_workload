# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/workload_db"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account:
#      https://myaccount.google.com/security
#   2. Generate an App Password (Google Account → Security → App passwords)
#      Select "Mail" + "Other (custom name)" → copy the 16-char password
#   3. Use the App Password below (NOT your regular Gmail password)
#
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"   # 16-char App Password (spaces optional)
EMAIL_FROM="your-gmail@gmail.com"
