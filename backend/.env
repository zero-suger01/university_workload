# Database
DATABASE_URL="postgresql://workload_user:workload_pass@localhost:5432/workload_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-access-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Email — SMTP (e.g. Gmail, Mailgun, SendGrid relay)
# Leave SMTP_HOST blank to disable sending (credentials printed to console in dev)
EMAIL_FROM="noreply@university.edu"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Cookie
COOKIE_SECRET="your-cookie-secret-change-in-production"
